# fal.ai API anahtarı — https://fal.ai/dashboard/keys
FAL_KEY=

# Cloudinary (mevcut hesabınla aynı — unsigned preset üretim önizlemesi için de kullanılabilir)
CLOUDINARY_CLOUD_NAME=dfclxpzlo
CLOUDINARY_UPLOAD_PRESET=visotale_uploads
CLOUDINARY_PREVIEW_FOLDER=visotale-previews

# Virgülle ayrılmış, CORS için izinli originler
ALLOWED_ORIGINS=https://visotale.com,https://www.visotale.com,https://visotale.de,https://www.visotale.de

# Resend — gecikmeli önizleme maili için
RESEND_API_KEY=
RESEND_FROM=Visotale <no-reply@visotale.com>
SITE_URL=https://visotale.com
# Ürün sayfasının TAM linki — mail'deki "Siparişini tamamla" butonu buraya gider
# (boş bırakılırsa SITE_URL'e düşer, ama o zaman sepete devam edemez, mutlaka gir)
PRODUCT_URL=https://visotale.com/products/SENIN-URUN-HANDLE-IN

# Shopify Admin API — tek seferlik indirim kodu oluşturmak için
SHOPIFY_STORE_DOMAIN=
# Dev Dashboard'daki custom app'in Settings sayfasında görünen Client ID / Client secret
# (SHOPIFY_ADMIN_TOKEN artık kullanılmıyor — yeni Dev Dashboard custom app'leri için
# Shopify statik token göstermiyor, bunun yerine bu ikisiyle OAuth ile token isteniyor)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-10
